{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Word Work",
  "identifier": "se.schiren.wordwork",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../frontend"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../frontend"
    },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Word Work",
        "width": 1200,
        "height": 820,
        "minWidth": 480,
        "minHeight": 360,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "© 2026 Mikke Schirén",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/ww-pandoc"
    ],
    "resources": {
      "../resources/sv/": "sv/",
      "../resources/filters/": "filters/",
      "../resources/templates/": "templates/",
      "../LICENSE": "licenses/LICENSE",
      "../NOTICE": "licenses/NOTICE",
      "../LICENSES/": "licenses/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "signingIdentity": "-"
    },
    "shortDescription": "Distraktionsfri ordbehandlare",
    "longDescription": "En lugn, distraktionsfri ordbehandlare för kulturjournalister och författare.",
    "publisher": "Mikke Schirén",
    "license": "Apache-2.0",
    "linux": {
      "deb": {
        "depends": [],
        "section": "editors"
      },
      "rpm": {
        "depends": []
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Swedish",
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
